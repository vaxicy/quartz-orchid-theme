  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#3A3440",
    "parameter": "#6E6878",
    "property": "#7C6A52",
    "function": "#2F7A6E",
    "method": "#2F7A6E",
    "type": "#6E6480",
    "class": "#6E6480",
    "interface": "#6E6480",
    "variable.readonly": "#9A5A32"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#9A93A6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#4A6E8C"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#8A6A24"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2F7A6E"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6E6480"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#9A5A32"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#3A3440"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#6E6878"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#7C6A52"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#857F8C"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9A93A6"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#4A6E8C"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8A6A24"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#9A5A32"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#8A6A24"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#332F3A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#332F3A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#332F3A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#A34A63"
      }
    }
  ]
}
